{
  "model": "opus",
  "effortLevel": "medium",
  "showThinkingSummaries": true,
  "crossSessionInbound": "accept",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  }
}
